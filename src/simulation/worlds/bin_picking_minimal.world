<?xml version="1.0"?>
<sdf version="1.7">
  <world name="bin_picking_world">
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- Table -->
    <model name="work_table">
      <static>true</static>
      <pose>0.5 -0.3 0 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry><box><size>1.0 0.8 0.03</size></box></geometry>
        </collision>
        <visual name="table_visual">
          <geometry><box><size>1.0 0.8 0.03</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.3 1</ambient>
            <diffuse>0.7 0.6 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bin -->
    <model name="work_bin">
      <static>true</static>
      <pose>0.5 0 0.07 0 0 0</pose>
      <link name="bin_base">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="base_collision">
          <geometry><box><size>0.4 0.3 0.01</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><box><size>0.4 0.3 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <!-- Front wall -->
      <link name="wall_f">
        <pose>0 0.15 0.06 0 0 0</pose>
        <collision name="wf_c"><geometry><box><size>0.4 0.01 0.12</size></box></geometry></collision>
        <visual name="wf_v"><geometry><box><size>0.4 0.01 0.12</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.5</ambient></material></visual>
      </link>
      <!-- Back wall -->
      <link name="wall_b">
        <pose>0 -0.15 0.06 0 0 0</pose>
        <collision name="wb_c"><geometry><box><size>0.4 0.01 0.12</size></box></geometry></collision>
        <visual name="wb_v"><geometry><box><size>0.4 0.01 0.12</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.5</ambient></material></visual>
      </link>
      <!-- Left wall -->
      <link name="wall_l">
        <pose>0.2 0 0.06 0 0 0</pose>
        <collision name="wl_c"><geometry><box><size>0.01 0.3 0.12</size></box></geometry></collision>
        <visual name="wl_v"><geometry><box><size>0.01 0.3 0.12</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.5</ambient></material></visual>
      </link>
      <!-- Right wall -->
      <link name="wall_r">
        <pose>-0.2 0 0.06 0 0 0</pose>
        <collision name="wr_c"><geometry><box><size>0.01 0.3 0.12</size></box></geometry></collision>
        <visual name="wr_v"><geometry><box><size>0.01 0.3 0.12</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.5</ambient></material></visual>
      </link>
    </model>

    <!-- Red cube -->
    <model name="object_cube">
      <pose>0.55 0.05 0.1 0 0 0</pose>
      <link name="cube_link">
        <collision name="cube_c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        </collision>
        <visual name="cube_v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Green cylinder -->
    <model name="object_cylinder">
      <pose>0.45 -0.05 0.1 0 0 0</pose>
      <link name="cyl_link">
        <collision name="cyl_c">
          <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="cyl_v">
          <geometry><cylinder><radius>0.02</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
