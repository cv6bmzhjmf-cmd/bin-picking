<?xml version="1.0"?>
<sdf version="1.7">
  <world name="bin_picking_world">
    <!-- Lighting -->
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Table -->
    <model name="work_table">
      <static>true</static>
      <pose>0.5 -0.3 0 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 0.8 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 0.8 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1.0</ambient>
            <diffuse>0.6 0.5 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bin (料箱) -->
    <model name="work_bin">
      <static>true</static>
      <pose>0.5 0 0.05 0 0 0</pose>
      <link name="bin_base">
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.4 0.3 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.4 0.3 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bin walls -->
    <model name="bin_walls">
      <static>true</static>
      <pose>0.5 0 0.07 0 0 0</pose>
      <!-- Front wall -->
      <link name="wall_front">
        <collision name="front_collision">
          <geometry>
            <box>
              <size>0.4 0.01 0.12</size>
            </box>
          </geometry>
          <pose>0 0.15 0.06 0 0 0</pose>
        </collision>
        <visual name="front_visual">
          <geometry>
            <box>
              <size>0.4 0.01 0.12</size>
            </box>
          </geometry>
          <pose>0 0.15 0.06 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
      <!-- Back wall -->
      <link name="wall_back">
        <collision name="back_collision">
          <geometry>
            <box>
              <size>0.4 0.01 0.12</size>
            </box>
          </geometry>
          <pose>0 -0.15 0.06 0 0 0</pose>
        </collision>
        <visual name="back_visual">
          <geometry>
            <box>
              <size>0.4 0.01 0.12</size>
            </box>
          </geometry>
          <pose>0 -0.15 0.06 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
      <!-- Left wall -->
      <link name="wall_left">
        <collision name="left_collision">
          <geometry>
            <box>
              <size>0.01 0.3 0.12</size>
            </box>
          </geometry>
          <pose>0.2 0 0.06 0 0 0</pose>
        </collision>
        <visual name="left_visual">
          <geometry>
            <box>
              <size>0.01 0.3 0.12</size>
            </box>
          </geometry>
          <pose>0.2 0 0.06 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
      <!-- Right wall -->
      <link name="wall_right">
        <collision name="right_collision">
          <geometry>
            <box>
              <size>0.01 0.3 0.12</size>
            </box>
          </geometry>
          <pose>-0.2 0 0.06 0 0 0</pose>
        </collision>
        <visual name="right_visual">
          <geometry>
            <box>
              <size>0.01 0.3 0.12</size>
            </box>
          </geometry>
          <pose>-0.2 0 0.06 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 0.5</ambient>
            <diffuse>0.6 0.6 0.6 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Objects in bin (geometric primitives) -->
    <model name="object_cube">
      <pose>0.55 0.05 0.1 0 0 0</pose>
      <link name="cube_link">
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <model name="object_cylinder">
      <pose>0.45 -0.05 0.1 0 0 0</pose>
      <link name="cyl_link">
        <collision name="cyl_collision">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="cyl_visual">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1.0</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stereo Camera (eye-to-hand, above the bin) -->
    <model name="stereo_camera">
      <static>true</static>
      <pose>0.5 0 0.5 0 0.785398 0</pose>
      <link name="camera_base">
        <!-- Left camera -->
        <sensor name="left_camera" type="camera">
          <pose>-0.03 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <plugin name="left_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/stereo_camera</namespace>
            </ros>
            <camera_name>left</camera_name>
            <frame_name>camera_left_optical</frame_name>
            <image_topic_name>image_raw</image_topic_name>
            <camera_info_topic_name>camera_info</camera_info_topic_name>
          </plugin>
        </sensor>

        <!-- Right camera -->
        <sensor name="right_camera" type="camera">
          <pose>0.03 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <plugin name="right_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/stereo_camera</namespace>
            </ros>
            <camera_name>right</camera_name>
            <frame_name>camera_right_optical</frame_name>
            <image_topic_name>image_raw</image_topic_name>
            <camera_info_topic_name>camera_info</camera_info_topic_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
